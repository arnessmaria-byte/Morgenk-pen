<Project Sdk="Microsoft.NET.Sdk">

  <!--
    BondeRavn: en ravn som følger deg i Valheim og coacher deg på dyrehold og avl.

    To byggemåter:
      1) Mot ekte spill:  dotnet build -c Release -p:ValheimDir="C:\Steam\steamapps\common\Valheim"
         (eller sett miljøvariabelen VALHEIM_INSTALL). Da brukes spillets assembly_valheim.dll.
      2) Uten spillet:    dotnet build
         Da brukes stubbene i ../stubs (kun for syntaks- og typekontroll, IKKE for å spille).
  -->

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>8</LangVersion>
    <AssemblyName>BondeRavn</AssemblyName>
    <RootNamespace>BondeRavn</RootNamespace>
    <Version>0.1.0</Version>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Deterministic>true</Deterministic>
    <DebugType>none</DebugType>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>

    <ValheimDir Condition="'$(ValheimDir)' == ''">$(VALHEIM_INSTALL)</ValheimDir>
    <ValheimManaged>$(ValheimDir)/valheim_Data/Managed</ValheimManaged>
    <UseRealGame Condition="'$(ValheimDir)' != '' And Exists('$(ValheimManaged)/assembly_valheim.dll')">true</UseRealGame>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BepInEx.Core" Version="5.4.21" ExcludeAssets="runtime" />
    <PackageReference Include="UnityEngine.Modules" Version="2022.3.62" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup Condition="'$(UseRealGame)' == 'true'">
    <Reference Include="assembly_valheim">
      <HintPath>$(ValheimManaged)/assembly_valheim.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup Condition="'$(UseRealGame)' != 'true'">
    <ProjectReference Include="../stubs/ValheimStubs.csproj">
      <Private>false</Private>
    </ProjectReference>
  </ItemGroup>

  <Target Name="WarnStubBuild" AfterTargets="Build" Condition="'$(UseRealGame)' != 'true'">
    <Warning Text="BondeRavn ble bygget mot STUBBER (ikke ekte assembly_valheim.dll). Bygg med -p:ValheimDir=... før du legger den i BepInEx/plugins." />
  </Target>

</Project>
