<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Minimale stubber av Valheim-klassene BondeRavn bruker.
    Assembly-navnet er med vilje "assembly_valheim" slik at BondeRavn.dll
    binder mot samme navn som spillets ekte assembly ved kjøring.
    Denne dll-en skal ALDRI kopieres inn i spillmappen.
  -->
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>8</LangVersion>
    <AssemblyName>assembly_valheim</AssemblyName>
    <RootNamespace></RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <DebugType>none</DebugType>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <NoWarn>CS0649;CS0414;CS0169</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="UnityEngine.Modules" Version="2022.3.62" ExcludeAssets="runtime" />
  </ItemGroup>
</Project>
