   "type": "object",
   "required": [
    "status"
   ],
   "additionalProperties": false,
   "properties": {
    "status": {
     "enum": [
      "BEKREFTET_ANKER",
      "BEKREFTET_TRANSKRIPSJON",
      "BEKREFTET_UTGAVETEKST",
      "BEKREFTET_SEKUNDAERT",
      "BEKREFTET_I_OVERSETTELSE",
      "DELVIS_BEKREFTET",
      "IKKE_AVLEST"
     ]
    },
    "evidence": {
     "type": "string"
    },
    "sha256": {
     "type": "string",
     "pattern": "^[0-9a-f]{64}$"
    },
    "basis": {
     "type": "string"
    },
    "mustReadIn": {
     "type": "string"
    }
   }
  },
  "gtAnchor": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "testament",
    "bookId",
    "bookSha256",
    "mtRef",
    "firstWordId",
    "lastWordId",
    "relation",
    "words"
   ],
   "properties": {
    "testament": {
     "const": "GT"
    },
    "bookId": {
     "type": "string",
     "pattern": "^gt-[a-z0-9]+$"
    },
    "bookSha256": {
     "type": "string",
     "pattern": "^[0-9a-f]{64}$"
    },
    "mtRef": {
     "type": "string"
    },
    "stepPublicationRef": {
     "type": "string"
    },
    "firstWordId": {
     "type": "string",
     "pattern": "^[0-9A-Za-z]{5}$"
    },
    "lastWordId": {
     "type": "string",
     "pattern": "^[0-9A-Za-z]{5}$"
    },
    "relation": {
     "enum": [
      "erstatter",
      "etter",
      "hele_verset"
     ]
    },
    "words": {
     "type": "array",
     "minItems": 1,
     "items": {
      "type": "object",
      "required": [
       "id",
       "position",
       "g"
      ],
      "additionalProperties": false,
      "properties": {
       "id": {
        "type": "string",
        "pattern": "^[0-9A-Za-z]{5}$"
       },
       "position": {
        "type": "integer",
        "minimum": 1
       },
       "g": {
        "type": "string",
        "minLength": 1
       }
      }
     }
    }
   }
  },
  "ntAnchor": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "testament",
    "bookId",
    "bookSha256",
    "chapter",
    "verse",
    "firstWordIndex",
    "lastWordIndex",
    "relation",
    "words"
   ],
   "properties": {
    "testament": {
     "const": "NT"
    },
    "bookId": {
     "type": "string",
     "pattern": "^[0-9a-z]{3}$"
    },
    "bookSha256": {
     "type": "string",
     "pattern": "^[0-9a-f]{64}$"
    },
    "r11LayerSha256": {
     "type": "string",
     "pattern": "^[0-9a-f]{64}$"
    },
    "r111Note": {
     "type": "string"
    },
    "chapter": {
     "type": "integer",
     "minimum": 1
    },
    "verse": {
     "type": "integer",
     "minimum": 1
    },
    "firstWordIndex": {
     "type": "integer",
     "minimum": 1
    },
    "lastWordIndex": {
     "type": "integer",
     "minimum": 1
    },
    "relation": {
     "enum": [
      "erstatter",
      "etter",
      "hele_verset"
     ]
    },
    "words": {
     "type": "array",
     "minItems": 1,
     "items": {
      "type": "object",
      "required": [
       "wordIndex",
       "g"
      ],
      "additionalProperties": false,
      "properties": {
       "wordIndex": {
        "type": "integer",
        "minimum": 1
       },
       "g": {
        "type": "string",
        "minLength": 1
       }
      }
     }
    }
   }
  },
  "editionSupport": {
   "type": "object",
   "required": [
    "edition",
    "verification"
   ],
   "additionalProperties": false,
   "description": "En utgave som har valgt lesningen. Utgaver er ikke vitner og har ikke siglum.",
