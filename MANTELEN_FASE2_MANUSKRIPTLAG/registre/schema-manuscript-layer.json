   ],
   "additionalProperties": false,
   "properties": {
    "siglum": {
     "type": "string",
     "minLength": 1
    },
    "locator": {
     "type": "string",
     "minLength": 1
    },
    "lang": {
     "enum": [
      "grc",
      "la",
      "syr"
     ]
    },
    "quoteType": {
     "enum": [
      "sitat",
      "parafrase",
      "omtale",
      "omstridt"
     ]
    },
    "wording": {
     "type": "string"
    },
    "witnessLimit": {
