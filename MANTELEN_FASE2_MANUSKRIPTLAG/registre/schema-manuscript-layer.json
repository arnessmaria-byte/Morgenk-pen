      "string",
      "null"
     ],
     "pattern": "^(\\*|C[0-9]?)$"
    },
    "locator": {
     "type": [
      "string",
      "null"
     ]
    },
    "reading": {
     "type": "string",
     "description": "Hele verset slik transkripsjonen har det for denne hånden."
    },
    "attested": {
     "type": "string",
     "description": "Utdraget der lesningen står, slik transkripsjonen har det."
    },
    "certainty": {
     "enum": [
      "lest",
      "usikre bokstaver",
      "delvis rekonstruert",
      "rekonstruert",
      "utelatt",
      "ikke avlest"
     ]
    },
    "note": {
     "type": "string"
    },
    "verification": {
     "type": "object",
     "required": [
      "status"
     ],
     "additionalProperties": false,
     "properties": {
      "status": {
       "enum": [
        "BEKREFTET_ANKER",
        "BEKREFTET_TRANSKRIPSJON",
        "BEKREFTET_UTGAVETEKST",
        "BEKREFTET_SEKUNDAERT",
        "BEKREFTET_I_OVERSETTELSE",
        "DELVIS_BEKREFTET",
        "IKKE_AVLEST"
       ]
      },
      "evidence": {
       "type": "string"
      },
      "sha256": {
       "type": "string",
       "pattern": "^[0-9a-f]{64}$"
      },
      "basis": {
       "type": "string"
      },
      "mustReadIn": {
       "type": "string"
      }
     }
    }
   }
  },
  "versionWitness": {
   "type": "object",
   "required": [
    "siglum",
    "lang",
    "vorlage",
    "verification"
   ],
   "additionalProperties": false,
   "properties": {
    "siglum": {
     "type": "string",
     "minLength": 1
    },
    "text": {
     "type": "string"
    },
    "lang": {
     "enum": [
      "grc",
      "la",
      "syr",
      "cop"
     ]
    },
    "norwegian": {
     "type": "array",
     "minItems": 1,
     "items": {
      "type": "object",
      "required": [
       "text",
       "kind"
