    },
    "compatibleWith": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "note": {
     "type": "string"
    },
    "verification": {
     "type": "object",
     "required": [
      "status"
     ],
     "additionalProperties": false,
     "properties": {
      "status": {
       "enum": [
        "BEKREFTET_ANKER",
        "BEKREFTET_TRANSKRIPSJON",
        "BEKREFTET_UTGAVETEKST",
        "BEKREFTET_SEKUNDAERT",
        "BEKREFTET_I_OVERSETTELSE",
        "DELVIS_BEKREFTET",
        "IKKE_AVLEST"
       ]
      },
      "evidence": {
       "type": "string"
      },
      "sha256": {
       "type": "string",
       "pattern": "^[0-9a-f]{64}$"
      },
      "basis": {
       "type": "string"
      },
      "mustReadIn": {
       "type": "string"
      }
     }
    }
   }
  },
  "reading": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "readingId",
    "label",
    "text",
    "lang",
    "morphology",
    "norwegian",
    "editionSupport",
    "manuscriptWitnesses",
    "versionWitnesses",
    "patristicWitnesses"
   ],
   "properties": {
    "readingId": {
     "type": "string",
     "pattern": "^[a-z][0-9]?$"
    },
    "label": {
     "type": "string"
    },
    "isR10": {
     "type": "boolean"
    },
    "agreesWith": {
     "type": "string"
    },
    "text": {
     "type": "string"
    },
    "textNote": {
     "type": "string"
    },
    "lang": {
     "enum": [
      "he",
      "grc"
     ]
    },
    "morphology": {
     "type": "string",
     "minLength": 1
    },
    "norwegian": {
     "type": "array",
     "minItems": 1,
     "items": {
      "type": "object",
      "required": [
       "text",
       "kind"
      ],
      "additionalProperties": false,
      "properties": {
       "text": {
        "type": "string",
        "minLength": 1
       },
       "kind": {
        "enum": [
         "ordrett",
         "tolkende",
         "r10"
        ]
       },
       "note": {
        "type": "string"
       }
      }
     }
    },
    "editionSupport": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/editionSupport"
     }
    },
    "manuscriptWitnesses": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/manuscriptWitness"
     }
    },
    "versionWitnesses": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/versionWitness"
     }
    },
    "patristicWitnesses": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/patristicWitness"
     }
    }
   },
   "anyOf": [
    {
     "properties": {
      "manuscriptWitnesses": {
       "minItems": 1
      }
     }
    },
    {
     "properties": {
      "versionWitnesses": {
       "minItems": 1
      }
     }
    },
    {
     "properties": {
      "patristicWitnesses": {
       "minItems": 1
      }
     }
    }
   ],
   "$comment": "Minst ett vitne per lesning (plan 1.2 regel 1). En lesning som bare står i utgaver, kan ikke registreres."
  },
  "unit": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "variantId",
    "pilotNr",
    "status",
    "ref",
    "anchor",
    "readings",
    "witnessPattern",
    "variantKind",
    "significance",
    "evaluation",
    "philologicalNote",
    "checks"
   ],
   "properties": {
    "variantId": {
     "type": "string",
     "pattern": "^(GT|NT)-[A-Z0-9]{3}-[0-9]{3}-[0-9]{3}-[0-9]{2}$"
    },
    "pilotNr": {
     "type": "integer"
    },
    "status": {
     "enum": [
      "UTKAST",
      "LÅST"
     ]
    },
    "ref": {
     "type": "object",
     "required": [
      "r10"
     ],
     "additionalProperties": false,
     "properties": {
      "r10": {
       "type": "string"
      },
      "mtRef": {
       "type": "string"
      },
      "stepPublicationRef": {
       "type": "string"
      },
      "western": {
       "type": "string"
      },
      "lxxRef": {
       "type": "string"
      },
      "ntRef": {
       "type": "string"
      }
     }
    },
    "anchor": {
     "oneOf": [
      {
       "$ref": "#/$defs/gtAnchor"
      },
      {
       "$ref": "#/$defs/ntAnchor"
      }
     ]
    },
    "r10Verse": {
     "type": "string"
    },
    "readings": {
     "type": "array",
     "minItems": 2,
     "items": {
      "$ref": "#/$defs/reading"
     }
    },
    "witnessPattern": {
     "type": "object",
     "required": [
      "computed",
      "code"
     ],
     "properties": {
      "computed": {
       "const": true
      },
      "code": {
       "type": "string",
       "minLength": 1
      }
     },
     "description": "Akse 1. Regnes maskinelt ut fra vitnene. Skrives aldri for hånd."
    },
    "variantKind": {
     "type": "object",
     "required": [
      "computed",
      "assigned"
     ],
     "additionalProperties": false,
     "description": "Akse 2. Beskrivende.",
     "properties": {
      "computed": {
       "type": "string"
      },
      "assigned": {
       "enum": [
        "ortografisk",
        "morfologisk",
        "leksikalsk",
        "pluss",
        "minus",
        "ordfølge",
        "harmonisering",
        "skrivefeil",
        "eksegetisk"
       ]
      },
      "assignedBy": {
       "type": "string"
      },
      "note": {
       "type": "string"
      }
     }
    },
    "significance": {
     "enum": [
      "betydning",
      "form",
      "ortografi"
     ]
    },
    "evaluation": {
     "type": "object",
     "required": [
      "class",
      "by",
      "date",
      "arguments",
      "literature",
      "dissent"
     ],
     "additionalProperties": false,
     "description": "Akse 3. Signert faglig skjønn. Settes aldri maskinelt.",
     "properties": {
      "class": {
       "enum": [
        "ikke vurdert",
        "A",
        "B",
        "C",
        "omstridt"
       ]
      },
      "by": {
       "type": [
        "string",
        "null"
       ]
      },
      "date": {
       "type": [
        "string",
        "null"
       ]
      },
      "arguments": {
       "type": "array",
       "items": {
        "type": "string"
       }
      },
      "literature": {
       "type": "array",
       "items": {
        "type": "string"
       }
      },
      "dissent": {
       "type": "array",
       "items": {
        "type": "string"
       }
      }
     },
     "if": {
      "properties": {
       "class": {
        "const": "ikke vurdert"
       }
      }
     },
     "then": {
      "properties": {
       "by": {
        "type": "null"
       },
       "date": {
        "type": "null"
       }
      }
     },
     "else": {
      "properties": {
       "by": {
        "type": "string",
        "minLength": 1
       },
       "date": {
        "type": "string",
        "minLength": 1
       },
       "arguments": {
        "minItems": 1
       },
       "literature": {
        "minItems": 1
       }
      }
     }
    },
    "philologicalNote": {
     "type": "string",
     "minLength": 40
    },
    "crossReferences": {
     "type": "array",
     "items": {
      "type": "object"
     }
    },
    "excludedWitnesses": {
     "type": "array",
     "items": {
      "type": "object",
      "required": [
       "siglum",
       "reason"
      ],
      "properties": {
       "siglum": {
        "type": "string",
        "minLength": 1
       },
       "reason": {
        "type": "string"
       }
      }
     }
    },
    "leads": {
     "type": "array",
     "items": {
      "type": "string"
     },
     "description": "Spor som må kontrolleres mot kilde. De er ikke vitner og teller ikke i vitnemønsteret."
    },
    "dataConflicts": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "provenance": {
     "type": "array",
     "items": {
      "type": "object"
     }
    },
    "checks": {
     "type": "object",
     "required": [
      "sigla",
      "anchor",
      "unicode",
      "doubleEntry"
     ],
     "properties": {
      "doubleEntry": {
       "enum": [
        "IKKE KJØRT",
        "BESTÅTT"
       ]
      }
     }
    }
   }
  }
 }
}
