    },
    "form": {
     "type": "string"
    },
    "note": {
     "type": "string"
    },
    "verification": {
     "type": "object",
     "required": [
      "status"
     ],
     "additionalProperties": false,
     "properties": {
      "status": {
       "enum": [
        "BEKREFTET_ANKER",
        "BEKREFTET_TRANSKRIPSJON",
        "BEKREFTET_UTGAVETEKST",
        "BEKREFTET_SEKUNDAERT",
        "BEKREFTET_I_OVERSETTELSE",
        "DELVIS_BEKREFTET",
        "IKKE_AVLEST"
       ]
      },
      "evidence": {
       "type": "string"
      },
      "sha256": {
       "type": "string",
       "pattern": "^[0-9a-f]{64}$"
      },
      "basis": {
       "type": "string"
      },
      "mustReadIn": {
       "type": "string"
      }
     }
    }
   }
  },
  "manuscriptWitness": {
   "type": "object",
   "required": [
    "siglum",
    "verification"
   ],
   "additionalProperties": false,
   "description": "Et fysisk håndskrift. Datering og oppbevaringssted hentes fra vitneregisteret via siglum.",
   "properties": {
    "siglum": {
     "type": "string",
     "minLength": 1
    },
    "hand": {
