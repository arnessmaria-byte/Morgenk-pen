{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://mantelen.no/schema/mlag.schema.v1-trinn0.json",
 "title": "MANTELEN manuskriptlag: variantenheter (Trinn 0)",
 "description": "Validerer skillet mellom utgaver og vitner, de tre adskilte aksene og ordankrene mot låst R10/R11.1. Datering, type og oppbevaringssted lagres bare i vitneregisteret, aldri i enheten.",
 "type": "object",
 "required": [
  "schemaVersion",
  "r10ReleaseId",
  "status",
  "units"
 ],
 "additionalProperties": false,
 "properties": {
  "schemaVersion": {
   "const": "mlag.schema.v1-trinn0"
  },
  "generated": {
   "type": "string"
  },
  "r10ReleaseId": {
   "type": "string"
  },
  "status": {
   "enum": [
    "UTKAST",
    "LÅST"
   ]
  },
  "registers": {
   "type": "object"
  },
  "notice": {
   "type": "string"
  },
  "units": {
   "type": "array",
   "minItems": 1,
   "items": {
    "$ref": "#/$defs/unit"
   }
  }
 },
 "$defs": {
