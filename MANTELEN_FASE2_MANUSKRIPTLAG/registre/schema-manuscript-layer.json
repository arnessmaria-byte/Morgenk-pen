      "additionalProperties": false,
      "properties": {
       "text": {
        "type": "string",
        "minLength": 1
       },
       "kind": {
        "enum": [
         "ordrett",
         "tolkende",
         "r10"
        ]
       },
       "note": {
        "type": "string"
       }
      }
     }
    },
    "readIn": {
     "type": "string"
    },
    "locator": {
     "type": "string"
    },
    "vorlage": {
     "enum": [
      "sikker",
      "sannsynlig",
      "kan ikke avgjøres"
     ]
    },
    "witnessLimit": {
     "type": "string"
    },
    "compatibleWith": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "note": {
     "type": "string"
    },
    "verification": {
     "type": "object",
     "required": [
      "status"
     ],
     "additionalProperties": false,
     "properties": {
      "status": {
       "enum": [
        "BEKREFTET_ANKER",
        "BEKREFTET_TRANSKRIPSJON",
        "BEKREFTET_UTGAVETEKST",
        "BEKREFTET_SEKUNDAERT",
        "BEKREFTET_I_OVERSETTELSE",
        "DELVIS_BEKREFTET",
        "IKKE_AVLEST"
       ]
      },
      "evidence": {
       "type": "string"
      },
      "sha256": {
       "type": "string",
       "pattern": "^[0-9a-f]{64}$"
      },
      "basis": {
       "type": "string"
      },
      "mustReadIn": {
       "type": "string"
      }
     }
    }
   }
  },
  "patristicWitness": {
   "type": "object",
   "required": [
    "siglum",
    "locator",
